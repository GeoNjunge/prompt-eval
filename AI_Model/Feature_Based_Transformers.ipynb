# === train_ridge_with_features.py ===
import os, json, joblib, numpy as np, pandas as pd, re
from sentence_transformers import SentenceTransformer
from sklearn.model_selection import train_test_split
from sklearn.linear_model import Ridge
from sklearn.multioutput import MultiOutputRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error
from sklearn.preprocessing import StandardScaler

CSV_PATH="/content/drive/MyDrive/FinalYearproject/ultra_diverse_prompts_v2.csv"
EMBEDDER_NAME = "sentence-transformers/all-MiniLM-L6-v2"
OUT_DIR = "scoring_artifacts"
Y_COLS = ["clarity","context","relevance","specificity","creativity"]

# helpers
GENERIC_VERBS = {"make","do","write","create","build","explain","describe","talk","summarize","implement","design","draft"}
DETAIL_CUES = {
    # General connectors
    "with","including","using","for","against","step","steps","and","or","also","considering",

    # Software engineering specific
    "code","implementation","algorithm","function","class","method","API","endpoint",
    "database","schema","migration","refactoring","optimization","performance","profiling",
    "testing","unit test","integration test","e2e test","security","vulnerability",
    "bug","debug","review","documentation","architecture","deployment","pipeline",
    "microservices","monolith","container","Docker","Kubernetes","CI/CD","logging",
    "observability","indexing","caching","schema","GraphQL","REST","OAuth","FastAPI",
    "Django","Node.js","TypeScript","React","state management","pattern","best practices",

    # Content creation specific
    "audience","persona","brand","voice","style","tone","keyword","SEO","content","pillar",
    "strategy","editorial","calendar","distribution","post","article","headline","caption",
    "video","script","infographic","template","KPI","engagement","conversion","viral",
    "metrics","platform","B2B","B2C","social media","blog","newsletter","example","template",

    # Education specific
    "lesson","objective","outcome","assessment","rubric","criteria","activity","task","quiz",
    "assignment","project","unit","curriculum","mapping","microlearning","flipped classroom",
    "STEM","pedagogy","differentiation","inclusion","digital literacy","edtech","tool",
    "formative","summative","peer","evaluation","feedback","learning","strategy","session",
    "extension","remediation","exercise","competency","framework","gamification"
}

def prompt_features(text: str) -> np.ndarray:
    """Extract small features to complement embeddings."""
    t = str(text).lower().strip()
    words = re.findall(r"[a-z]+", t)
    wc = len(words)
    uniq = len(set(words))
    unique_ratio = (uniq / wc) if wc else 0.0
    has_digits = 1.0 if re.search(r"\d", t) else 0.0
    has_detail = 1.0 if any(c in t for c in DETAIL_CUES) else 0.0
    gen_ratio = (sum(1 for w in words if w in GENERIC_VERBS) / wc) if wc else 1.0
    length_norm = min(wc, 64) / 64.0  # cap length at 64 words
    return np.array([length_norm, unique_ratio, has_digits, has_detail, gen_ratio], dtype=np.float32)

df = pd.read_csv(CSV_PATH)
texts = df["prompt"].astype(str).tolist()
Y = df[Y_COLS].astype(float).values

embedder = SentenceTransformer(EMBEDDER_NAME)  # CPU OK

def embed_batch(texts, bs=64):
    out = []
    for i in range(0, len(texts), bs):
        out.append(embedder.encode(texts[i:i+bs], normalize_embeddings=True, show_progress_bar=False))
    return np.vstack(out)

X_embed = embed_batch(texts, bs=64)
X_feats = np.vstack([prompt_features(t) for t in texts])

scaler = StandardScaler()
X_feats_std = scaler.fit_transform(X_feats)

X = np.hstack([X_embed, X_feats_std])

X_tr, X_va, Y_tr, Y_va = train_test_split(X, Y, test_size=0.2, random_state=42)

 # Tiny alpha sweep (no CV)
alphas = [0.1, 0.3, 1.0, 3.0, 10.0]
best = None
for a in alphas:
    model = MultiOutputRegressor(Ridge(alpha=a, random_state=42))
    model.fit(X_tr, Y_tr)
    Y_hat = model.predict(X_va)
    mae = np.mean([mean_absolute_error(Y_va[:,i], Y_hat[:,i]) for i in range(5)])
    # Calculate RMSE by taking the square root of MSE
    rmse = np.mean([np.sqrt(mean_squared_error(Y_va[:,i], Y_hat[:,i])) for i in range(5)])
    score = {"alpha": a, "MAE_macro": float(mae), "RMSE_macro": float(rmse)}
    print("alpha=", a, "→", score)
    if best is None or rmse < best["RMSE_macro"]:
        best = score

print("\nChosen alpha:", best)

# 5) Retrain on ALL data with best alpha
final_model = MultiOutputRegressor(Ridge(alpha=best["alpha"], random_state=42))
final_model.fit(X, Y)

input_text = ["Build a full-stack notes application with a Node.js Express backend, a PostgreSQL database, and a React frontend. Include user authentication, note tagging, and search.",
              "Write a 300-word persuasive essay arguing for the ethical regulation of Artificial General Intelligence, using at least two real-world examples.",
              "Train a binary classification model using XGBoost on the provided CSV. Evaluate it using ROC AUC, F1, and confusion matrix. Show the full code.",
              "Create a to-do list app with authentication.",
              "Develop a full-stack to-do list application using React for the frontend, Node.js with Express for the backend, and PostgreSQL as the database. Implement user authentication via email and password. Key features should include creating, editing, deleting, and marking tasks as complete, along with setting due dates and categorizing tasks. The application should have a responsive design and be deployable via Docker.",
              "Write a short story about a robot learning emotions."]


**Running my tests**

print("\n--- Making Test Predictions ---")

print("clarity  context  relevance  specificity  creativity ")
for prompt in input_text:
  embedded_text = embed_batch([prompt])

  features = prompt_features(prompt).reshape(1, -1)

  scaled_features = scaler.transform(features)

  processed_input = np.hstack([embedded_text, scaled_features])

  prediction = final_model.predict(processed_input)
  print(prompt)
  print(prediction)


# ---------- save artifacts ----------
os.makedirs(OUT_DIR, exist_ok=True)
joblib.dump(final_model, f"{OUT_DIR}/regressor.joblib")
joblib.dump(scaler, f"{OUT_DIR}/feats_scaler.joblib")
with open(f"{OUT_DIR}/meta.json", "w") as f:
    json.dump({
        "embedder_name": EMBEDDER_NAME,
        "targets": Y_COLS,
        "alpha": best["alpha"],
        "val_metrics": best,
        "version": "ridge-v2-feats",
        "feature_spec": ["length_norm","unique_ratio","has_digits","has_detail","gen_ratio"]
    }, f, indent=2)

print("\nSaved artifacts to", OUT_DIR)

**K-Fold testing**

from sklearn.model_selection import KFold
kf = KFold(n_splits=5, shuffle=True, random_state=42)

all_mae_scores = []
all_rmse_scores = []

macro_mae_scores = []
macro_rmse_scores = []

for fold, (train_index, val_index) in enumerate(kf.split(X)):
    print(f"\n--- Fold {fold+1}/{kf.n_splits} ---")
    X_train_fold, X_val_fold = X[train_index], X[val_index]
    Y_train_fold, Y_val_fold = Y[train_index], Y[val_index]

    final_model.fit(X_train_fold, Y_train_fold)

    Y_pred_fold = final_model.predict(X_val_fold)

    fold_mae_targets = [mean_absolute_error(Y_val_fold[:, i], Y_pred_fold[:, i]) for i in range(Y.shape[1])]
    fold_rmse_targets = [np.sqrt(mean_squared_error(Y_val_fold[:, i], Y_pred_fold[:, i])) for i in range(Y.shape[1])]

    # Store individual target scores
    all_mae_scores.append(fold_mae_targets)
    all_rmse_scores.append(fold_rmse_targets)

    # Calculate macro average MAE and RMSE for the current fold
    macro_mae_fold = np.mean(fold_mae_targets)
    macro_rmse_fold = np.mean(fold_rmse_targets)
    macro_mae_scores.append(macro_mae_fold)
    macro_rmse_scores.append(macro_rmse_fold)

    print(f"  Macro MAE: {macro_mae_fold:.4f}, Macro RMSE: {macro_rmse_fold:.4f}")

print("\n--- Cross-Validation Results ---")
print(f"Average Macro MAE across all folds: {np.mean(macro_mae_scores):.4f}")
print(f"Average Macro RMSE across all folds: {np.mean(macro_rmse_scores):.4f}")

# Optional: print average MAE and RMSE for each target variable across all folds
print("\nAverage MAE per target variable across all folds:")
for i, col in enumerate(Y_COLS):
    avg_mae_target = np.mean([score[i] for score in all_mae_scores])
    print(f"  {col}: {avg_mae_target:.4f}")

print("\nAverage RMSE per target variable across all folds:")
for i, col in enumerate(Y_COLS):
    avg_rmse_target = np.mean([score[i] for score in all_rmse_scores])
    print(f"  {col}: {avg_rmse_target:.4f}")
